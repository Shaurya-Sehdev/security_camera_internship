<%- include("../partials/head") %>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');
  
  body {
    font-family: 'Inter', sans-serif;
    background: #000000;
    color: #ffffff;
    margin: 0;
    padding: 0;
  }
  
 main {
  min-height: 100vh;
  padding: 120px 20px 60px; /* Added top padding to push content below navbar */
  position: relative;
}

  
  /* Background decorations */
  .bg-decoration {
    position: fixed;
    pointer-events: none;
    z-index: 0;
  }
  
  .bg-glow-1 {
    top: 10%;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 255, 229, 0.1) 0%, transparent 70%);
    filter: blur(60px);
  }
  
  .bg-glow-2 {
    bottom: 10%;
    right: 10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 184, 212, 0.08) 0%, transparent 70%);
    filter: blur(80px);
  }
  
  .container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 60px;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 1s ease forwards;
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .page-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    margin-bottom: 15px;
    letter-spacing: -2px;
    background: linear-gradient(135deg, #00ffe5 0%, #00b8d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }
  
  .page-subtitle {
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: #cccccc;
    font-weight: 400;
  }
  
  .cameras-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 30px;
  }
  
  .favourite-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(0, 255, 229, 0.2);
    border-radius: 20px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: all 0.4s ease;
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.8s ease forwards;
    display: flex;
    flex-direction: column;
  }
  
  .favourite-card:nth-child(1) { animation-delay: 0.1s; }
  .favourite-card:nth-child(2) { animation-delay: 0.2s; }
  .favourite-card:nth-child(3) { animation-delay: 0.3s; }
  .favourite-card:nth-child(4) { animation-delay: 0.4s; }
  .favourite-card:nth-child(5) { animation-delay: 0.5s; }
  .favourite-card:nth-child(6) { animation-delay: 0.6s; }
  .favourite-card:nth-child(7) { animation-delay: 0.7s; }
  .favourite-card:nth-child(8) { animation-delay: 0.8s; }
  .favourite-card:nth-child(9) { animation-delay: 0.9s; }
  
  @keyframes slideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .favourite-card:hover {
    transform: translateY(-10px);
    border-color: #00ffe5;
    box-shadow: 0 20px 60px rgba(0, 255, 229, 0.3);
  }
  
  .favourite-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: linear-gradient(135deg, #ff0080 0%, #ff4499 100%);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 10;
    box-shadow: 0 4px 15px rgba(255, 0, 128, 0.4);
  }
  
  .media-container {
    width: 100%;
    height: 250px;
    background: #000000;
    border-bottom: 2px solid rgba(0, 255, 229, 0.3);
    position: relative;
    overflow: hidden;
  }
  
  .camera-video,
  .camera-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .no-media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(0, 255, 229, 0.05) 0%, rgba(0, 184, 212, 0.05) 100%);
    color: #666666;
  }
  
  .no-media-icon {
    font-size: 4rem;
    margin-bottom: 10px;
    opacity: 0.3;
  }
  
  .no-media-text {
    font-size: 1rem;
    font-weight: 600;
  }
  
  .camera-content {
    padding: 30px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .camera-name {
    font-size: 1.8rem;
    font-weight: 700;
    color: #00ffe5;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .camera-info-grid {
    display: grid;
    gap: 12px;
    margin-bottom: 20px;
  }
  
  .camera-info-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #cccccc;
    font-size: 1rem;
  }
  
  .info-label {
    font-weight: 600;
    color: #ffffff;
    min-width: 100px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .info-value {
    color: #aaaaaa;
    flex: 1;
  }
  
  .status-online {
    color: #00ff88;
    font-weight: 600;
  }
  
  .status-offline {
    color: #ff4444;
    font-weight: 600;
  }
  
  .status-active {
    color: #ffaa00;
    font-weight: 600;
  }
  
  .camera-actions {
    margin-top: auto;
    display: flex;
    gap: 10px;
  }
  
  .btn-view {
    flex: 1;
    padding: 14px 20px;
    background: linear-gradient(135deg, #00ffe5 0%, #00b8d4 100%);
    color: #000000;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 10px;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 255, 229, 0.3);
    position: relative;
    overflow: hidden;
    display: inline-block;
  }
  
  .btn-view::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
  }
  
  .btn-view:hover::before {
    left: 100%;
  }
  
  .btn-view:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 255, 229, 0.5);
  }
  
  .btn-remove {
    flex: 1;
    padding: 14px 20px;
    background: rgba(255, 68, 68, 0.15);
    border: 2px solid rgba(255, 68, 68, 0.4);
    color: #ff4444;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 10px;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .btn-remove:hover {
    background: rgba(255, 68, 68, 0.25);
    border-color: #ff4444;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 68, 68, 0.3);
  }
  
  .empty-state {
    text-align: center;
    padding: 100px 20px;
    max-width: 600px;
    margin: 0 auto;
    opacity: 0;
    animation: fadeInUp 1s ease forwards 0.3s;
  }
  
  .empty-icon {
    font-size: 6rem;
    margin-bottom: 30px;
    opacity: 0.2;
  }
  
  .empty-title {
    font-size: 2rem;
    font-weight: 700;
    color: #666666;
    margin-bottom: 15px;
  }
  
  .empty-text {
    font-size: 1.2rem;
    color: #555555;
    margin-bottom: 30px;
    line-height: 1.6;
  }
  
  .btn-browse {
    display: inline-block;
    padding: 18px 40px;
    background: linear-gradient(135deg, #00ffe5 0%, #00b8d4 100%);
    color: #000000;
    font-size: 1.2rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.4s ease;
    box-shadow: 0 10px 40px rgba(0, 255, 229, 0.4);
    position: relative;
    overflow: hidden;
  }
  
  .btn-browse::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
  }
  
  .btn-browse:hover::before {
    left: 100%;
  }
  
  .btn-browse:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 50px rgba(0, 255, 229, 0.6);
  }
  
  @media (max-width: 768px) {
    main {
      padding: 40px 15px;
    }
    
    .cameras-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .page-header {
      margin-bottom: 40px;
    }
    
    .camera-content {
      padding: 20px;
    }
    
    .media-container {
      height: 200px;
    }
    
    .camera-actions {
      flex-direction: column;
    }
  }
  
  @media (max-width: 480px) {
    .camera-name {
      font-size: 1.5rem;
    }
    
    .info-label {
      min-width: 90px;
      font-size: 0.9rem;
    }
    
    .info-value {
      font-size: 0.9rem;
    }
  }
</style>
</head>
<body>
  <!-- Background decorations -->
  <div class="bg-decoration bg-glow-1"></div>
  <div class="bg-decoration bg-glow-2"></div>
  
  <%- include("../partials/nav") %>

  <main>
    <div class="container">
      <div class="page-header">
        <h1 class="page-title">My Favourite Cameras</h1>
        <p class="page-subtitle">Your personally curated surveillance collection</p>
      </div>

      <% if (cameras && cameras.length > 0) { %>
        <div class="cameras-grid">
          <% cameras.forEach(camera => { %>
            <% if (camera) { %>
              <div class="favourite-card">
                <div class="media-container">
                  <div class="favourite-badge">
                    <span>Favourite</span>
                  </div>
                  
                  <% if (camera.videoUrl) { %>
                    <video 
                      src="<%= camera.videoUrl %>" 
                      controls 
                      class="camera-video"
                    ></video>
                  <% } else if (camera.photoUrl) { %>
                    <img 
                      src="<%= camera.photoUrl %>" 
                      alt="<%= camera.cameraName || 'Camera feed' %>" 
                      class="camera-image"
                    />
                  <% } else { %>
                    <div class="no-media-placeholder">
                      <div class="no-media-icon">📹</div>
                      <div class="no-media-text">No Video/Image Available</div>
                    </div>
                  <% } %>
                </div>

                <div class="camera-content">
                  <h2 class="camera-name" title="<%= camera.cameraName || 'Unnamed Camera' %>">
                    <%= camera.cameraName || 'Unnamed Camera' %>
                  </h2>
                  
                  <div class="camera-info-grid">
                    <div class="camera-info-item">
                      <span class="info-label">
                        <span>📍</span>
                        <span>Location</span>
                      </span>
                      <span class="info-value"><%= camera.location || 'N/A' %></span>
                    </div>
                    
                    <div class="camera-info-item">
                      <span class="info-label">
                        <span>⚡</span>
                        <span>Status</span>
                      </span>
                      <span class="info-value <%= camera.status === 'Online' ? 'status-online' : (camera.status === 'Active' ? 'status-active' : 'status-offline') %>">
                        <%= camera.status || 'Offline' %>
                      </span>
                    </div>
                    
                    <div class="camera-info-item">
                      <span class="info-label">
                        <span>🎯</span>
                        <span>Detection</span>
                      </span>
                      <span class="info-value"><%= camera.detectionStatus || 'No Detection Data' %></span>
                    </div>
                  </div>

                  <div class="camera-actions">
                    <a href="/cameras/<%= camera._id %>" class="btn-view">
                      View Details
                    </a>
                    <form action="/favourites/<%= camera._id %>/remove" method="POST" style="flex: 1;">
                      <button type="submit" class="btn-remove" style="width: 100%;">
                        Remove
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon">💔</div>
          <h2 class="empty-title">No Favourite Cameras Yet</h2>
          <p class="empty-text">
            Start building your collection by adding cameras to your favourites. Browse available cameras to get started!
          </p>
          <a href="/cameras" class="btn-browse">
            Browse Available Cameras
          </a>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>