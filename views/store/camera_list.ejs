<%- include("../partials/head") %>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');
  
  body {
    font-family: 'Inter', sans-serif;
    background: #000000;
    color: #ffffff;
    margin: 0;
    padding: 0;
  }
  
  main {
    min-height: 100vh;
     padding-top: 120px;
  padding-left: 20px;
  padding-right: 20px;
  padding-bottom: 40px;
    background: #000000;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 60px;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 1s ease forwards;
    position: relative;
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .page-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    margin-bottom: 15px;
    letter-spacing: -2px;
    background: linear-gradient(135deg, #00ffe5 0%, #00b8d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }
  
  .page-subtitle {
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: #cccccc;
    font-weight: 400;
    max-width: 700px;
    margin: 0 auto;
  }
  
  .cameras-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .cameras-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 30px;
  }
  
  .camera-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(0, 255, 229, 0.2);
    border-radius: 20px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: all 0.4s ease;
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.8s ease forwards;
    display: flex;
    flex-direction: column;
  }
  
  .camera-card:nth-child(1) { animation-delay: 0.1s; }
  .camera-card:nth-child(2) { animation-delay: 0.2s; }
  .camera-card:nth-child(3) { animation-delay: 0.3s; }
  .camera-card:nth-child(4) { animation-delay: 0.4s; }
  .camera-card:nth-child(5) { animation-delay: 0.5s; }
  .camera-card:nth-child(6) { animation-delay: 0.6s; }
  .camera-card:nth-child(7) { animation-delay: 0.7s; }
  .camera-card:nth-child(8) { animation-delay: 0.8s; }
  .camera-card:nth-child(9) { animation-delay: 0.9s; }
  
  @keyframes slideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .camera-card:hover {
    transform: translateY(-10px);
    border-color: #00ffe5;
    box-shadow: 0 20px 60px rgba(0, 255, 229, 0.3);
  }
  
  .camera-video-container {
    width: 100%;
    height: 250px;
    background: #000000;
    border-bottom: 2px solid rgba(0, 255, 229, 0.3);
    position: relative;
    overflow: hidden;
  }
  
  .camera-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .no-video-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(0, 255, 229, 0.05) 0%, rgba(0, 184, 212, 0.05) 100%);
    color: #666666;
  }
  
  .no-video-icon {
    font-size: 4rem;
    margin-bottom: 10px;
    opacity: 0.3;
  }
  
  .no-video-text {
    font-size: 1rem;
    font-weight: 600;
  }
  
  .camera-content {
    padding: 30px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .camera-name {
    font-size: 1.8rem;
    font-weight: 700;
    color: #00ffe5;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }
  
  .camera-info-grid {
    display: grid;
    gap: 12px;
    margin-bottom: 20px;
  }
  
  .camera-info-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #cccccc;
    font-size: 1rem;
  }
  
  .info-label {
    font-weight: 600;
    color: #ffffff;
    min-width: 100px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .info-value {
    color: #aaaaaa;
    flex: 1;
  }
  
  .status-online {
    color: #00ff88;
    font-weight: 600;
  }
  
  .status-offline {
    color: #ff4444;
    font-weight: 600;
  }
  
  .status-active {
    color: #ffaa00;
    font-weight: 600;
  }
  
  .camera-actions {
    margin-top: auto;
    display: flex;
    gap: 10px;
  }
  
  .btn-view-details {
    flex: 1;
    padding: 15px 25px;
    background: linear-gradient(135deg, #00ffe5 0%, #00b8d4 100%);
    color: #000000;
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 12px;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 0 5px 20px rgba(0, 255, 229, 0.3);
    position: relative;
    overflow: hidden;
    display: inline-block;
  }
  
  .btn-view-details::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
  }
  
  .btn-view-details:hover::before {
    left: 100%;
  }
  
  .btn-view-details:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0, 255, 229, 0.5);
  }
  
  .no-cameras-container {
    text-align: center;
    padding: 100px 20px;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .no-cameras-icon {
    font-size: 6rem;
    margin-bottom: 30px;
    opacity: 0.2;
  }
  
  .no-cameras-title {
    font-size: 2rem;
    font-weight: 700;
    color: #666666;
    margin-bottom: 15px;
  }
  
  .no-cameras-text {
    font-size: 1.2rem;
    color: #555555;
    line-height: 1.6;
  }
  
  /* Decorative background elements */
  .bg-decoration {
    position: fixed;
    pointer-events: none;
    z-index: 0;
  }
  
  .bg-glow-1 {
    top: 10%;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 255, 229, 0.1) 0%, transparent 70%);
    filter: blur(60px);
  }
  
  .bg-glow-2 {
    bottom: 10%;
    right: 10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 184, 212, 0.08) 0%, transparent 70%);
    filter: blur(80px);
  }
  
  @media (max-width: 768px) {
    main {
      padding: 30px 15px;
    }
    
    .cameras-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .page-header {
      margin-bottom: 40px;
    }
    
    .camera-content {
      padding: 20px;
    }
    
    .camera-video-container {
      height: 200px;
    }
  }
  
  @media (max-width: 480px) {
    .camera-name {
      font-size: 1.5rem;
    }
    
    .info-label {
      min-width: 90px;
      font-size: 0.9rem;
    }
    
    .info-value {
      font-size: 0.9rem;
    }
  }
</style>
</head>
<body>
  <!-- Background decorations -->
  <div class="bg-decoration bg-glow-1"></div>
  <div class="bg-decoration bg-glow-2"></div>
  
  <%- include("../partials/nav") %>
  
  <main>
    <div class="page-header">
      <h1 class="page-title">Available Surveillance Cameras</h1>
      <p class="page-subtitle">Monitor and manage your security infrastructure in real-time</p>
    </div>

    <div class="cameras-container">
      <% if (registeredCameras && registeredCameras.length > 0) { %>
        <div class="cameras-grid">
          <% registeredCameras.forEach(camera => { %>
            <div class="camera-card">
              <div class="camera-video-container">
                <% if (camera.videoUrl) { %>
                  <video 
                    src="<%= camera.videoUrl %>" 
                    controls 
                    class="camera-video"
                  ></video>
                <% } else { %>
                  <div class="no-video-placeholder">
                    <div class="no-video-icon">📹</div>
                    <div class="no-video-text">No Video Available</div>
                  </div>
                <% } %>
              </div>

              <div class="camera-content">
                <h2 class="camera-name"><%= camera.cameraName || 'Unnamed Camera' %></h2>
                
                <div class="camera-info-grid">
                  <div class="camera-info-item">
                    <span class="info-label">
                      <span>📍</span>
                      <span>Location</span>
                    </span>
                    <span class="info-value"><%= camera.location || 'N/A' %></span>
                  </div>
                  
                  <div class="camera-info-item">
                    <span class="info-label">
                      <span>⚡</span>
                      <span>Status</span>
                    </span>
                    <span class="info-value <%= camera.status === 'Online' ? 'status-online' : (camera.status === 'Active' ? 'status-active' : 'status-offline') %>">
                      <%= camera.status || 'Offline' %>
                    </span>
                  </div>
                  
                  <div class="camera-info-item">
                    <span class="info-label">
                      <span>🎯</span>
                      <span>Detection</span>
                    </span>
                    <span class="info-value"><%= camera.detectionStatus || 'No Detection Data' %></span>
                  </div>
                </div>

                <div class="camera-actions">
                  <a href="/cameras/<%= camera._id %>" class="btn-view-details">
                    View Details
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-cameras-container">
          <div class="no-cameras-icon">📹</div>
          <h2 class="no-cameras-title">No Cameras Available</h2>
          <p class="no-cameras-text">
            There are currently no surveillance cameras registered in the system. Please add cameras to start monitoring.
          </p>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>