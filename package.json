{
  "name": "airbnb",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon app.js",
    "build_css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "cleanup": "node cleanup.js && node cleanup_chunks.js",
    "dev": "concurrently \"npm start\" \"npm run fast_worker\" \"npm run slow_worker\"",
    "fast_worker": "node workers/fastWorker.js",
    "slow_worker": "node workers/slowWorker.js",
    "workers": "concurrently \"npm run fast_worker\" \"npm run slow_worker\"",
    "producer": "node queues/producer.js",
    "dev_pipeline": "npm run cleanup && concurrently \"npm run fast_worker\" \"npm run producer\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:redis": "docker-compose up -d redis",
    "system:start": "npm run cleanup && concurrently \"npm start\" \"npm run workers\"",
    "setup": "docker-compose up -d redis && npm run system:start"
  },
  "author": "Shaurya",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.0",
    "bullmq": "^5.66.1",
    "connect-mongodb-session": "^5.0.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "ioredis": "^5.8.2",
    "mongodb": "^6.21.0",
    "mongoose": "^8.21.1",
    "mysql2": "^3.15.2"
  }
}
